<!DOCTYPE html>
<html>
  <head>
    <title>{{title}}</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <!-- Load the client component. --> 
    <script src="https://js.braintreegateway.com/web/3.134.0/js/client.min.js"></script> 
    <!-- Load the PayPal Checkout component. --> 
    <script src="https://js.braintreegateway.com/web/3.134.0/js/paypal-checkout.min.js"></script>
    <!-- includes jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>
  </head>
  <body data-store-currency="{{storefront.currency}}" data-store-zero-amount="{{storefront.zeroAmount}}">
    {{#if storefront.rateLabel}}
    <div role="note" style="background:#fff8dd;border-bottom:1px solid #ead58a;color:#5d4a00;font:600 0.86rem/1.4 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;padding:0.65rem 1rem;text-align:center;">
      {{storefront.rateLabel}}
    </div>
    {{/if}}
    {{{body}}}
  </body>
</html>
