            </div>
            <div class="summary-row">
                <span>Due Today (First Reload)</span>
                <span>$50.00</span>
            </div>
        </div>

        <div class="payment-info">
            🔒 Secure payment powered by PayPal
        </div>

        <div id="paypal-button-container"></div>
    </div>
</section>

<script>
// Pre-defined billing data for auto-reload prepaid
const billingData = {
    type: 'unscheduled',
    description: 'Auto-Reload Prepaid Account',
    reloadAmount: '50.00',
    reloadThreshold: '10.00'
};

// Initialize payment flow
initializePayment(billingData);
</script>