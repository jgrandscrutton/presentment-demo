# Copy this file to config.env or .env. When both exist, config.env takes precedence.
# Use Braintree Sandbox credentials only; never commit the populated file.
PORT=3000
# Loopback is the safe default. Set HOST explicitly only on a trusted network.
HOST=127.0.0.1
BRAINTREE_ENVIRONMENT=sandbox
MERCHANT_ID=your_braintree_sandbox_merchant_id
PUBLIC_KEY=your_braintree_sandbox_public_key
PRIVATE_KEY=your_braintree_sandbox_private_key
