<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="A sandbox demonstration of server-side payment routing across dynamically discovered Braintree merchant accounts.">
  <title>{{title}} · PhonePal</title>
  <link rel="stylesheet" href="/stylesheets/demo.css">
</head>
<body class="routing-demo" data-catalog-available="{{catalogAvailable}}" data-catalog-status="{{catalogStatus}}">
  <a class="skip-link" href="#runner">Skip to scenario runner</a>
  <header class="site-header">
    <a class="brand" href="/" aria-label="PhonePal home">
      <img src="/img/pp-logo.png" alt="" width="40" height="40">
      <span>PhonePal</span>
    </a>
    <nav class="demo-nav" aria-label="Demo sections">
      <a class="is-current" href="#runner" aria-current="page">Demo</a>
      <a href="#account-registry">Accounts</a>
      <a href="/demo/log">Activity</a>
      <a href="/demo/disputes">Disputes</a>
      <a href="/demo/preflight">Preflight</a>
      <a href="/demo/routes">Routes</a>
    </nav>
    <div class="environment-pill" aria-label="Environment: Braintree Sandbox">
      <span class="status-dot" aria-hidden="true"></span>
      <span class="environment-label-full">Braintree Sandbox</span>
      <span class="environment-label-short">Sandbox</span>
    </div>
  </header>

  <main>
    <section class="demo-hero" aria-labelledby="page-title">
      <div>
        <p class="eyebrow">Server-selected routing · Braintree Sandbox</p>
        <h1 id="page-title">Route payments with clear proof.</h1>
        <p class="hero-summary">
          Run a payment intent through server-selected merchant-account routing, then compare the decision with Braintree’s response.
        </p>
        <div class="hero-actions">
          <a class="hero-start-link" href="#runner">Run a scenario <span aria-hidden="true">&darr;</span></a>
          <a class="hero-preflight-link" href="/demo/preflight">Check presenter readiness</a>
        </div>
        <ul class="hero-meta" aria-label="Demo summary">
          <li><strong>{{scenarios.length}}</strong><span>ready-made scenarios</span></li>
          <li><strong>{{accountCount}}</strong><span>discovered accounts</span></li>
          <li><strong>{{currencyCount}}</strong><span>available currencies</span></li>
        </ul>
      </div>
    </section>

    <section class="runner-section" id="runner" aria-labelledby="runner-title">
      <div class="section-heading runner-heading">
        <div>
          <p class="section-kicker">Interactive sandbox</p>
          <h2 id="runner-title">Route a payment</h2>
        </div>
        <p>Start with a preset, confirm the route, then complete the Sandbox payment.</p>
      </div>

      <ol class="runner-steps" aria-label="Scenario runner steps">
        <li class="is-current" data-runner-step="choose" aria-current="step"><span>1</span><div><strong>Choose</strong><small>Pick a ready-made scenario</small></div></li>
        <li data-runner-step="preview"><span>2</span><div><strong>Preview</strong><small>Confirm the server route</small></div></li>
        <li data-runner-step="pay"><span>3</span><div><strong>Pay</strong><small id="pay-step-copy">Use a Sandbox payment method</small></div></li>
        <li data-runner-step="verify"><span>4</span><div><strong>Verify</strong><small>Compare the returned account</small></div></li>
      </ol>

      {{#unless catalogAvailable}}
        <div class="catalog-unavailable" role="alert">
          <div>
            <p class="section-kicker">Gateway unavailable</p>
            <h3>Merchant accounts could not be discovered safely.</h3>
            <p>{{discoveryError}} Routing and payment controls stay disabled so no request can fall through to a gateway default.</p>
          </div>
          <button class="secondary-button catalog-refresh-button" type="button" data-catalog-refresh>Retry discovery</button>
          <p class="refresh-status" data-refresh-status></p>
        </div>
      {{/unless}}

      {{#if scenarios.length}}
        <div class="scenario-picker">
          <div class="scenario-picker-heading">
            <div>
              <h3>Start with a preset</h3>
              <p>Each preset fills in safe demo values. You can adjust them below.</p>
            </div>
            <span>{{scenarios.length}} available</span>
          </div>
          <div class="scenario-presets" role="group" aria-label="Scenario presets">
            {{#each scenarios}}
              <button class="scenario-preset{{#if @first}} is-selected{{/if}}" type="button"
                data-scenario-id="{{id}}" data-currency="{{currency}}"
                data-payment-type="{{paymentType}}" data-amount="{{amount}}"
                data-transaction-mode="{{transactionMode}}"
                data-expected-outcome="{{expectedOutcome}}"
                data-recurring-model="{{recurringModel}}"
                data-dispute-scenario="{{disputeScenario}}"
                data-unsupported="{{unsupported}}"
                aria-pressed="{{#if @first}}true{{else}}false{{/if}}">
                <span class="preset-currency">{{currency}}</span>
                <span class="preset-copy">
                  <strong>{{title}}</strong>
                  <small>{{subtitle}}</small>
                  <span class="preset-outcome preset-outcome-{{outcomeClass}}">{{outcomeLabel}}</span>
                </span>
              </button>
            {{/each}}
          </div>
        </div>
      {{/if}}

      <div class="demo-workbench">
        <section class="checkout-panel" aria-labelledby="checkout-title">
          <div class="panel-heading">
            <div>
              <p class="panel-index">01 · Customer intent</p>
              <h3 id="checkout-title">Payment setup</h3>
            </div>
            <span class="unchanged-pill">Sandbox only</span>
          </div>

          <p class="panel-intro">Enter the business intent. The server selects the merchant account.</p>

          <form id="demo-payment-form" novalidate>
            <input type="hidden" id="scenario-id" value="{{initialScenarioId}}">
            <div class="intent-grid">
              <label>
                <span>Payment type</span>
                <select id="payment-type" name="paymentType" {{#unless catalogAvailable}}disabled{{/unless}}>
                  <option value="one_time">One-time purchase</option>
                  <option value="recurring">Recurring billing</option>
                </select>
              </label>
              <label>
                <span>Currency</span>
                <select id="currency" name="currency" {{#unless catalogAvailable}}disabled{{/unless}}>
                  {{#if currencyOptions.length}}
                    {{#each currencyOptions}}
                      <option value="{{code}}"
                        data-symbol="{{symbol}}"
                        data-minimum="{{minimum}}"
                        data-maximum="{{maximum}}"
                        data-step="{{step}}"
                        data-demo-amount="{{demoAmount}}"
                        data-demo-rate="{{demoRate}}"
                        data-processor-declined-amount="{{processorDeclinedAmount}}"
                        data-gateway-rejected-amount="{{gatewayRejectedAmount}}"
                        data-unsupported="{{unsupported}}">{{label}}</option>
                    {{/each}}
                  {{else}}
                    <option value="">Unavailable</option>
                  {{/if}}
                </select>
              </label>
              <label class="amount-field">
                <span>Amount</span>
                <span class="amount-input">
                  <span id="currency-prefix">{{initialCurrencySymbol}}</span>
                  <input id="amount" name="amount" type="number"
                    inputmode="{{initialInputMode}}"
                    min="{{initialMinimum}}" max="{{initialMaximum}}" step="{{initialStep}}"
                    value="{{initialAmount}}" required {{#unless catalogAvailable}}disabled{{/unless}}>
                </span>
                <small class="amount-guidance">
                  <span id="demo-rate">{{initialDemoRate}}</span> · {{demoFxLabel}}
                </small>
              </label>
            </div>

            <fieldset id="payment-method-chooser" class="payment-method-chooser" disabled>
              <legend>Payment method</legend>
              <div class="payment-method-options">
                <label id="payment-method-card-option" class="payment-method-option is-selected">
                  <input id="payment-method-card" type="radio" name="paymentMethod" value="card" checked>
                  <span class="payment-method-icon" aria-hidden="true">••••</span>
                  <span><strong>Card</strong><small>Secure Hosted Fields</small></span>
                </label>
                <label id="payment-method-paypal-option" class="payment-method-option" hidden>
                  <input id="payment-method-paypal" type="radio" name="paymentMethod" value="paypal">
                  <span class="payment-method-icon payment-method-paypal-icon" aria-hidden="true">P</span>
                  <span><strong>PayPal</strong><small>Approve in PayPal Sandbox</small></span>
                </label>
              </div>
              <p id="payment-method-availability" class="payment-method-availability" aria-live="polite">Checking methods for the server-selected account…</p>
            </fieldset>

            <details class="advanced-options">
              <summary>
                <span>Advanced options</span>
                <small>Authorization and expected-failure controls</small>
              </summary>
              <div class="advanced-options-grid">
                <label>
                  <span>Gateway action</span>
                  <select id="transaction-mode" name="transactionMode" {{#unless catalogAvailable}}disabled{{/unless}}>
                    <option value="submit_for_settlement">Sale · submit for settlement</option>
                    <option value="authorize_only">Authorize only</option>
                  </select>
                </label>
                <label>
                  <span>Expected outcome</span>
                  <select id="expected-outcome" name="expectedOutcome" {{#unless catalogAvailable}}disabled{{/unless}}>
                    <option value="approved">Approved</option>
                    <option value="processor_declined">Processor decline · Sandbox</option>
                    <option value="gateway_rejected">Gateway rejection · Sandbox</option>
                  </select>
                </label>
              </div>
            </details>

            <section id="recurring-options" class="recurring-options" aria-labelledby="recurring-options-title" hidden>
              <div class="recurring-options-heading">
                <div>
                  <p class="panel-index">Recurring execution</p>
                  <h4 id="recurring-options-title">Choose who controls the schedule</h4>
                </div>
                <span class="vault-pill">One shared vault</span>
              </div>
              <div class="recurring-option-grid">
                <label>
                  <span>Recurring model</span>
                  <select id="recurring-model" name="recurringModel" aria-describedby="recurring-availability" {{#unless catalogAvailable}}disabled{{/unless}}>
                    {{#each recurringModels}}
                      <option value="{{value}}">{{label}}</option>
                    {{/each}}
                  </select>
                </label>
                <label id="plan-field" hidden>
                  <span>Braintree plan</span>
                  <select id="plan-id" name="planId" {{#unless catalogAvailable}}disabled{{/unless}}>
                    <option value="">{{#if initialPlanId}}Select a discovered plan{{else}}No plan available{{/if}}</option>
                    {{#each planOptions}}
                      <option value="{{id}}" data-currency="{{currency}}"
                        data-price="{{price}}" data-billing-frequency="{{billingFrequency}}">{{label}}</option>
                    {{/each}}
                  </select>
                  <small id="plan-availability" aria-live="polite">No plan available</small>
                </label>
              </div>
              <p id="recurring-availability" class="stage-notice" role="status" aria-live="polite" hidden></p>
              <div class="recurring-model-copy">
                <p id="merchant-managed-copy"><strong>Model A:</strong> PhonePal sends the first and subsequent billing-cycle transactions, so the presenter can run the next cycle immediately.</p>
                <p id="braintree-subscription-copy" hidden><strong>Model B:</strong> Braintree controls the billing schedule. Create the subscription now, then view its status and next billing date.</p>
              </div>
              <p class="plan-discovery-copy">Plan discovery: <strong>{{planDiscoveryStatus}}</strong> · {{planDiscoveryMessage}}</p>
              <div class="plan-availability-data" hidden aria-hidden="true">
                {{#each planAvailability}}
                  <span data-plan-currency="{{currency}}" data-plan-available="{{available}}">{{message}}</span>
                {{/each}}
              </div>
            </section>

            <p class="fx-disclaimer">{{demoFxDisclaimer}}</p>
            <p id="sandbox-outcome-notice" class="fx-disclaimer" hidden>
              This exact amount is a Braintree Sandbox test trigger, not a converted demo price.
            </p>

            <div id="recurring-notice" class="stage-notice" hidden>
              <strong>Recurring route ready</strong>
              <span id="recurring-notice-copy">The payment method will be verified and vaulted on the server-resolved recurring merchant account. Approved sale mode is required for this flow.</span>
            </div>

            <div id="no-route-notice" class="stage-notice no-route-notice" hidden>
              <strong>No configured route</strong>
              <span>The server will stop before generating a client token or calling Braintree.</span>
            </div>

            <fieldset id="card-fields" class="card-fields is-disabled" disabled>
              <legend>Sandbox card</legend>
              <div class="hosted-field-group hosted-field-wide">
                <label for="card-number">Card number</label>
                <div id="card-number" class="hosted-field" aria-label="Card number"></div>
              </div>
              <div class="hosted-field-group">
                <label for="expiration-date">Expiry</label>
                <div id="expiration-date" class="hosted-field" aria-label="Expiration date"></div>
              </div>
              <div class="hosted-field-group">
                <label for="cvv">Security code</label>
                <div id="cvv" class="hosted-field" aria-label="Security code"></div>
              </div>
            </fieldset>

            <section id="three-d-secure-panel" class="three-d-secure-panel" aria-labelledby="three-d-secure-title" hidden>
              <div class="three-d-secure-heading">
                <div>
                  <p class="panel-index">Card authentication</p>
                  <h4 id="three-d-secure-title">3D Secure 2</h4>
                </div>
                <span id="three-d-secure-policy-badge" class="three-d-secure-policy-badge">Checking policy</span>
              </div>
              <p id="three-d-secure-policy-copy" class="three-d-secure-policy-copy">The server-selected account decides whether authentication is required.</p>
              <label id="three-d-secure-optional-control" class="three-d-secure-toggle" hidden>
                <input id="three-d-secure-enabled" type="checkbox" checked>
                <span><strong>Use optional 3D Secure</strong><small>Turn this off to compare a plain card nonce on an optional route.</small></span>
              </label>
              <fieldset id="three-d-secure-scenarios" class="three-d-secure-scenarios" aria-describedby="three-d-secure-card-copy">
                <legend>Sandbox test-card guidance</legend>
                <div>
                  <label><input type="radio" name="threeDSecureScenario" value="frictionless" checked><span><strong>Frictionless</strong><small>No challenge</small></span></label>
                  <label><input type="radio" name="threeDSecureScenario" value="challenge"><span><strong>Challenge</strong><small>Complete issuer step</small></span></label>
                  <label><input type="radio" name="threeDSecureScenario" value="failed"><span><strong>Failed</strong><small>Stops before sale</small></span></label>
                </div>
              </fieldset>
              <p id="three-d-secure-card-copy" class="three-d-secure-card-copy">Enter <code id="three-d-secure-card-number">4000 0000 0000 2701</code>, expiry <code>01/29</code>, and any 3-digit CVV. Selecting a path changes this guidance. Replace the card number entered above to test a different path.</p>
              <p id="three-d-secure-status" class="three-d-secure-status" role="status" aria-live="polite">Ready to authenticate after tokenization.</p>
            </section>

            <section id="paypal-fields" class="paypal-fields" aria-labelledby="paypal-fields-title" hidden>
              <div class="paypal-fields-heading">
                <div>
                  <h4 id="paypal-fields-title">Pay with PayPal Sandbox</h4>
                  <p id="paypal-flow-copy">Approve this payment securely in PayPal. No PayPal credentials touch PhonePal.</p>
                </div>
                <span class="paypal-mediated-pill">via Braintree</span>
              </div>
              <div id="paypal-button" class="paypal-button" aria-live="polite"></div>
              <p class="paypal-sandbox-hint">A Sandbox buyer account is required. Closing the PayPal window will safely return you here.</p>
            </section>

            <p class="sandbox-card-hint" id="sandbox-card-hint" hidden>Sandbox: use <code>4111 1111 1111 1111</code>, any future expiry, and any 3-digit CVV.</p>
            <p class="sandbox-card-hint" id="dispute-card-hint" hidden>Dispute scenario: use <code>4023 8984 9398 8028</code>, any future expiry, and any 3-digit CVV. Braintree settles the sale and opens a Sandbox dispute.</p>
            <div id="checkout-status" class="checkout-status" role="status" aria-live="polite">
              {{#if catalogAvailable}}Previewing the selected route…{{else}}Gateway unavailable. Retry merchant account discovery to enable this demo.{{/if}}
            </div>

            <div class="checkout-actions">
              <button id="preview-route" class="secondary-button" type="button" {{#unless catalogAvailable}}disabled{{/unless}}>Preview route</button>
              <button id="run-payment" class="primary-button" type="submit" disabled>
                <span id="run-payment-label">Run sandbox payment</span>
                <span aria-hidden="true">→</span>
              </button>
            </div>
          </form>

          <section id="recurring-actions" class="recurring-actions" aria-labelledby="recurring-actions-title" hidden>
            <div>
              <p class="panel-index">Saved payment method</p>
              <h4 id="recurring-actions-title">Continue the recurring story</h4>
              <p id="recurring-action-status" role="status" aria-live="polite"></p>
            </div>
            <div class="recurring-action-buttons">
              <button id="run-next-cycle" class="primary-button" type="button">Run next billing cycle</button>
              <button id="run-vault-one-time" class="secondary-button" type="button">Charge one-time route from same vault</button>
              <button id="refresh-subscription" class="secondary-button" type="button" hidden>View subscription status</button>
              <button id="cancel-subscription" class="danger-button" type="button" hidden>Cancel subscription</button>
            </div>
            <p class="recurring-action-note">Follow-up controls send only this demo's server-owned audit event ID. Customer, payment-method, subscription, and merchant-account IDs never become browser authority.</p>
          </section>
        </section>

        <section class="inspector-panel" aria-labelledby="inspector-title">
          <div class="panel-heading inspector-heading">
            <div>
              <p class="panel-index">02 · Server decision + proof</p>
              <h3 id="inspector-title">Route evidence</h3>
            </div>
            <span id="inspector-state" class="inspector-state {{#if catalogAvailable}}is-waiting{{else}}is-blocked{{/if}}">
              {{#if catalogAvailable}}Waiting{{else}}Unavailable{{/if}}
            </span>
          </div>

          <div id="route-summary" class="route-summary" aria-live="polite">
            <div class="route-node intent-node">
              <span>Intent</span>
              <strong id="intent-summary">{{#if catalogAvailable}}{{initialCurrency}} · One-time{{else}}Gateway unavailable{{/if}}</strong>
            </div>
            <span class="route-arrow" aria-hidden="true">→</span>
            <div class="route-node account-node">
              <span>Selected account</span>
              <strong id="account-summary">{{#if catalogAvailable}}Resolving…{{else}}No catalog{{/if}}</strong>
            </div>
          </div>

          <p id="route-reason" class="route-reason">
            {{#if catalogAvailable}}The server is evaluating the current discovered catalog.{{else}}{{discoveryError}}{{/if}}
          </p>

          <div class="verification-card" id="verification-card" hidden>
            <span class="verification-icon" id="verification-icon" aria-hidden="true">✓</span>
            <div>
              <strong id="verification-title">Route verified</strong>
              <p id="verification-copy"></p>
            </div>
          </div>

          <dl id="three-d-secure-proof" class="three-d-secure-proof" hidden>
            <div><dt>3DS policy</dt><dd id="three-d-secure-policy-proof">—</dd></div>
            <div><dt>Evidence applies to</dt><dd id="three-d-secure-scope-proof">Current payment attempt</dd></div>
            <div><dt>Authentication status</dt><dd id="three-d-secure-status-proof">Not performed</dd></div>
            <div><dt>Liability shift available</dt><dd id="liability-shift-possible-proof">—</dd></div>
            <div><dt>Liability shifted</dt><dd id="liability-shifted-proof">—</dd></div>
          </dl>

          <dl id="recurring-proof" class="recurring-proof" hidden>
            <div><dt>Recurring model</dt><dd id="recurring-model-proof">—</dd></div>
            <div><dt>Gateway billing evidence</dt><dd><code id="transaction-source-proof">—</code></dd></div>
          </dl>

          <details class="inspector-details">
            <summary>Decision trace <span id="trace-count">0 checks</span></summary>
            <ol id="decision-trace" class="decision-trace"></ol>
          </details>

          <details class="inspector-details">
            <summary>Redacted server request</summary>
            <pre id="request-json">{}</pre>
          </details>

          <details class="inspector-details" id="result-details">
            <summary>Sanitized Braintree result</summary>
            <pre id="result-json">No transaction has been sent.</pre>
          </details>

          <a id="control-panel-link" class="control-panel-link" href="https://sandbox.braintreegateway.com/" target="_blank" rel="noopener noreferrer" hidden>
            <span id="control-panel-link-label">Open in Sandbox Control Panel</span> <span aria-hidden="true">↗</span>
          </a>
        </section>
      </div>
    </section>

    <section class="registry-section" id="account-registry" aria-labelledby="registry-title">
      <div class="section-heading registry-heading">
        <div>
          <p class="section-kicker">Gateway configuration</p>
          <h2 id="registry-title">Discovered accounts</h2>
        </div>
        <div class="registry-actions">
          <p data-catalog-stale-content>{{accountCount}} accounts · {{currencyCount}} discovered currencies</p>
          <button class="secondary-button catalog-refresh-button" type="button" data-catalog-refresh>Refresh discovery</button>
          <span class="refresh-status" data-refresh-status></span>
        </div>
      </div>

      <dl class="catalog-metadata" data-catalog-stale-content>
        <div><dt>Gateway merchant ID</dt><dd><code>{{gatewayMerchantId}}</code></dd></div>
        <div><dt>Discovery status</dt><dd><span class="catalog-status status-{{catalogStatus}}">{{catalogStatus}}</span></dd></div>
        <div><dt>Discovered at</dt><dd>{{#if discoveredAt}}<time datetime="{{discoveredAt}}">{{discoveredAtLabel}}</time>{{else}}{{discoveredAtLabel}}{{/if}}</dd></div>
        <div><dt>Policy overlay</dt><dd>{{policyStatus}}</dd></div>
      </dl>

      {{#if hasWarnings}}
        <aside class="catalog-warnings" aria-labelledby="catalog-warning-title" data-catalog-stale-content>
          <h3 id="catalog-warning-title">Catalog warnings</h3>
          <ul>
            {{#each warnings}}
              <li><code>{{code}}</code> {{message}}</li>
            {{/each}}
          </ul>
        </aside>
      {{/if}}

      {{#if accounts.length}}
        <div class="account-grid" data-catalog-stale-content>
          {{#each accounts}}
            <article class="account-card{{#if isDefault}} default-account{{/if}}">
              <div class="account-card-topline">
                <span class="currency-mark" aria-label="Currency {{currency}}">{{currency}}</span>
                <span class="account-status {{statusClass}}"><span aria-hidden="true"></span>{{status}}</span>
              </div>
              <div class="account-title-row">
                <div>
                  <p class="account-label">{{label}}</p>
                  <h3><code>{{merchantAccountId}}</code></h3>
                </div>
                {{#if isDefault}}<span class="default-pill" title="Gateway context only; routing never falls back to this account.">Gateway default · no fallback</span>{{/if}}
              </div>
              <p class="account-purpose">{{purpose}}</p>
              <div class="assignment-state assignment-{{assignmentState}}">{{assignmentStateLabel}}</div>
              <div class="account-meta">
                <div>
                  <span class="meta-label">Payment roles</span>
                  {{#if hasPaymentTypes}}
                    <div class="type-list">
                      {{#each paymentTypes}}
                        <span class="type-pill type-{{key}}">{{label}} <small>{{sourceLabel}}</small></span>
                      {{/each}}
                    </div>
                  {{else}}
                    <span class="unassigned-copy">No routing roles</span>
                  {{/if}}
                </div>
                <div class="role-source">
                  <span class="meta-label">Role source</span>
                  <strong>{{roleSourceLabel}}</strong>
                </div>
                <div>
                  <span class="meta-label">Payment methods</span>
                  <div class="type-list payment-method-list">
                    {{#each paymentMethods}}
                      <span class="type-pill payment-method-pill payment-method-{{key}}">{{label}}</span>
                    {{/each}}
                  </div>
                </div>
                <div class="three-d-secure-account-policy">
                  <span class="meta-label">Card 3DS policy</span>
                  <strong class="account-policy-value {{threeDSecurePolicyClass}}">{{threeDSecurePolicyLabel}}</strong>
                </div>
              </div>
            </article>
          {{/each}}
        </div>
      {{else}}
        <div class="empty-registry">
          <strong>No merchant account catalog is available.</strong>
          <span>Refresh discovery after checking the Sandbox gateway credentials and connectivity.</span>
        </div>
      {{/if}}

      <p class="policy-note" data-catalog-stale-content><strong>Assignment note:</strong> roles come from the merchant-specific policy overlay when present. Any remaining routes are assigned deterministically from active discovered accounts; extra variants remain visible as “Available · not assigned”.</p>
    </section>

  </main>

  <footer>
    <p>PhonePal · Braintree routing demonstration</p>
    <p>Routing demo · Sandbox only</p>
  </footer>

