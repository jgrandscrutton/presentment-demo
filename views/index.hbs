{{!-- Plans --}}
<section class="section bg-gray" id="plans">
  <div class="container">
    <h2 class="section-title">Choose your plan</h2>
    <p class="section-subtitle">Flexible SIM-only plans. No hidden fees. Cancel anytime.</p>
    <div class="plans-grid">

      <div class="plan-card">
        <p class="plan-name">Pay As You Go</p>
        <p class="plan-tagline">For flexible usage</p>
        <div class="plan-price">{{currencySymbol}}25<span>/month</span></div>
        <hr class="plan-divider">
        <ul class="plan-features">
          <li>Variable monthly usage</li>
          <li>Secure vaulted wallet</li>
          <li>Flexible recurring billing</li>
          <li>Cancel anytime</li>
        </ul>
        <a href="/recurring" class="btn btn-outline" style="text-align:center">Choose Pay As You Go</a>
      </div>

      <div class="plan-card featured">
        <div class="plan-featured-tag">Most popular</div>
        <p class="plan-name">Unlimited</p>
        <p class="plan-tagline">For everyday use</p>
        <div class="plan-price">{{currencySymbol}}35<span>/month</span></div>
        <hr class="plan-divider">
        <ul class="plan-features">
          <li>Unlimited Data</li>
          <li>Unlimited calls & texts</li>
          <li>5G ready</li>
          <li>Roam in 30+ countries</li>
          <li>30-day rolling contract</li>
        </ul>
        <a href="/subscription" class="btn btn-primary" style="text-align:center">Choose Unlimited</a>
      </div>

      <div class="plan-card">
        <p class="plan-name">Phone + Plan</p>
        <p class="plan-tagline">Device and service together</p>
        <div class="plan-price">{{currencySymbol}}60<span>/month</span></div>
        <hr class="plan-divider">
        <ul class="plan-features">
          <li>{{currencySymbol}}199 activation payment</li>
          <li>Unlimited calls & texts</li>
          <li>5G ready</li>
          <li>Roam in 60+ countries</li>
          <li>Personal hotspot</li>
          <li>30-day rolling contract</li>
        </ul>
        <a href="/bundled" class="btn btn-outline" style="text-align:center">Choose Bundle</a>
      </div>

    </div>
  </div>
</section>
