<!-- views/device-detail.hbs -->
<style>
    .dd-crumb { background: #f5f7fa; border-bottom: 1px solid #E0E8F0; padding: 12px 2rem; font-size: 0.825rem; color: #6C7378; }
    .dd-crumb-inner, .dd-wrap { max-width: 1200px; margin: 0 auto; }
    .dd-crumb a { color: #6C7378; text-decoration: none; }
    .dd-crumb span { color: #333; }

    .dd-hero { padding: 3rem 2rem; border-bottom: 1px solid #E0E8F0; }
    .dd-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: flex-start; }

    .dd-visual { background: #f0f7ff; border-radius: 20px; padding: 40px 32px 32px; display: flex; flex-direction: column; align-items: center; position: relative; text-align: center; }
    .dd-badge { position: absolute; top: 16px; left: 16px; background: #003087; color: #fff; font-size: 0.75rem; font-weight: 700; padding: 4px 12px; border-radius: 50px; text-transform: uppercase; letter-spacing: 0.04em; }
    .dd-badge.gold { background: #FFC439; color: #003087; }
    .dd-emoji { font-size: 8rem; line-height: 1; margin-bottom: 28px; filter: drop-shadow(0 8px 24px rgba(0,48,135,0.15)); }
    .dd-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #6C7378; margin-bottom: 8px; }
    .dd-options { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
    .dd-pill { padding: 6px 14px; border-radius: 50px; border: 2px solid #C8D8E8; background: #fff; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.15s ease; color: #333; font-family: inherit; }
    .dd-pill.active { border-color: #003087; background: #003087; color: #fff; }
    .dd-pill:hover:not(.active) { border-color: #0070ba; color: #0070ba; }

    .dd-brand { font-size: 0.9rem; font-weight: 600; color: #0070ba; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px; }
    .dd-title { font-size: 2.2rem; font-weight: 800; color: #003087; margin-bottom: 10px; line-height: 1.15; }
    .dd-tagline { color: #6C7378; margin-bottom: 28px; }
    .dd-price-block { background: #f5f5f5; border-radius: 12px; padding: 20px 24px; margin-bottom: 20px; }
    .dd-price { font-size: 2.4rem; font-weight: 800; color: #003087; line-height: 1; }
    .dd-price-sub { font-size: 0.85rem; color: #6C7378; margin-top: 6px; }
    #paypal-button-container { margin-bottom: 16px; min-height: 55px; }
    .dd-trust { display: flex; gap: 16px; flex-wrap: wrap; font-size: 0.78rem; color: #6C7378; padding: 14px 0; border-top: 1px solid #E0E8F0; border-bottom: 1px solid #E0E8F0; margin-bottom: 24px; }
    .dd-highlights { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .dd-highlights li { display: flex; align-items: center; gap: 10px; font-size: 0.9rem; }
    .dd-highlights li::before { content: '✓'; display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; background: #003087; color: #fff; border-radius: 50%; font-size: 0.7rem; font-weight: 700; flex-shrink: 0; }

    .dd-body { padding: 3rem 2rem; }
    .dd-body h2 { font-size: 1.5rem; color: #003087; margin-bottom: 16px; }
    .dd-body p { color: #6C7378; line-height: 1.8; font-size: 0.95rem; }
    .dd-spec { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
    .dd-spec th, .dd-spec td { padding: 11px 14px; text-align: left; border-bottom: 1px solid #E8EFF5; vertical-align: top; }
    .dd-spec th { color: #6C7378; font-weight: 600; width: 38%; background: #f5f5f5; }
    .dd-spec tr:last-child th, .dd-spec tr:last-child td { border-bottom: none; }

    @media (max-width: 768px) { .dd-grid { grid-template-columns: 1fr; gap: 32px; } }
</style>

<div class="dd-crumb">
    <div class="dd-crumb-inner">
        <a href="/">Home</a> &rsaquo; <a href="/devices">Devices</a> &rsaquo; <span>{{device.brand}} {{device.name}}</span>
    </div>
</div>

<section class="dd-hero">
    <div class="dd-wrap dd-grid">
        <div class="dd-visual">
            {{#if device.badge}}<div class="dd-badge {{#if device.badgeGold}}gold{{/if}}">{{device.badge}}</div>{{/if}}
            <div class="dd-emoji">{{device.emoji}}</div>

            <p class="dd-label">Colour</p>
            <div class="dd-options">
                {{#each device.colours}}
                <button type="button" class="dd-pill colour-pill {{#if @first}}active{{/if}}" data-colour="{{this}}">{{this}}</button>
                {{/each}}
            </div>

            <p class="dd-label" style="margin-top:16px">Storage</p>
            <div class="dd-options">
                {{#each device.storage}}
                <button type="button" class="dd-pill storage-pill {{#if @first}}active{{/if}}" data-size="{{size}}" data-price="{{upfrontPrice}}">{{size}}</button>
                {{/each}}
            </div>
        </div>

        <div>
            <p class="dd-brand">{{device.brand}}</p>
            <h1 class="dd-title">{{device.name}}</h1>
            <p class="dd-tagline">{{device.tagline}}</p>

            <div class="dd-price-block">
                <div class="dd-price">£<span id="price-upfront">{{device.upfrontPrice}}</span></div>
                <div class="dd-price-sub">One-time payment</div>
            </div>

            <div id="paypal-button-container"></div>

            <div class="dd-trust">
                <span>🔒 Secure checkout</span>
                <span>🚚 Free next-day delivery</span>
                <span>↩️ 30-day returns</span>
            </div>

            <p class="dd-label" style="margin-bottom:10px">Why you'll love it</p>
            <ul class="dd-highlights">
                {{#each device.highlights}}<li>{{this}}</li>{{/each}}
            </ul>
        </div>
    </div>
</section>

<section class="dd-body">
    <div class="dd-wrap dd-grid">
        <div>
            <h2>About this device</h2>
            <p>{{device.description}}</p>
        </div>
        <div>
            <h2>Full specifications</h2>
            <table class="dd-spec">
                <tbody>
                    {{#each fullSpecsArray}}
                    <tr><th>{{label}}</th><td>{{value}}</td></tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</section>

<script>
// Shared with the PayPal button: createOrder/onApprove read these values at click time,
// so changing colour/storage below updates what gets charged.
const billingData = {
    type: 'one-time',
    deviceName: '{{device.brand}} {{device.name}}',
    colour: document.querySelector('.colour-pill.active') ? document.querySelector('.colour-pill.active').dataset.colour : '',
    storage: '{{device.storage.0.size}}',
    amount: '{{device.upfrontPrice}}',
    containerId: 'paypal-button-container'
};
billingData.description = billingData.deviceName + ' (' + billingData.storage + ', ' + billingData.colour + ')';

function refreshDescription() {
    billingData.description = billingData.deviceName + ' (' + billingData.storage + ', ' + billingData.colour + ')';
}

document.querySelectorAll('.colour-pill').forEach(function (btn) {
    btn.addEventListener('click', function () {
        document.querySelectorAll('.colour-pill').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        billingData.colour = btn.dataset.colour;
        refreshDescription();
    });
});

document.querySelectorAll('.storage-pill').forEach(function (btn) {
    btn.addEventListener('click', function () {
        document.querySelectorAll('.storage-pill').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        billingData.storage = btn.dataset.size;
        billingData.amount = btn.dataset.price;
        document.getElementById('price-upfront').textContent = btn.dataset.price;
        refreshDescription();
    });
});

// payment-flow.js loads after this view (see layouts/store.hbs), so wait for load.
window.addEventListener('load', function () {
    oneTimePayment(billingData);
});
</script>
