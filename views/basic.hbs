<div id="demo-container" data-currency="{{currency}}">
  <h2>Braintree Recurring Billing Demo</h2>

  <label for="billing-type">Select Billing Type:</label>
  <select id="billing-type">
    <option value="">-- Select Type --</option>
    <option value="subscription">Subscription (Fixed/Fixed/Ongoing)</option>
    <option value="recurring">Recurring (Variable/Fixed/Ongoing)</option>
    <option value="unscheduled">Unscheduled (Variable/Variable/Ongoing)</option>
    <option value="installments">Installments (Fixed/Fixed/Defined)</option>
    <option value="hybrid">Hybrid (One-off + Recurring)</option>
  </select>

  <div id="payment-details" style="display: none; margin-top: 20px;"></div>

  <button id="continue-btn" type="button" style="display: none; margin-top: 20px;">
    Continue to Braintree checkout
  </button>

  {{> billing-demo-note}}
  <div id="paypal-button-container" style="margin-top: 20px;"></div>
</div>
