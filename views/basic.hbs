<section class="billing-hero"><div class="container"><p class="detail-label">Braintree sandbox</p><h1>Recurring billing demo</h1><p>Choose a billing model, authorize a payment method, and manage future charges from Billing.</p></div></section>
<section class="section"><div class="container demo-billing-layout" data-storefront-payment data-kind="demo" data-initial-type="{{initialBillingType}}">
  <form data-demo-billing class="co-panel">
    <h2 class="co-section-title">Configure your plan</h2>
    <div class="form-group"><label class="form-label" for="billing-type">Billing model</label><select class="form-input" id="billing-type" name="type">
      <option value="subscription">Subscription · fixed payments</option><option value="recurring">Usage billing · variable payments</option><option value="unscheduled">Automatic top-ups</option><option value="installments">Installments · fixed number of payments</option><option value="hybrid">Setup fee and recurring payments</option>
    </select></div>
    <div class="form-group"><label class="form-label" for="description">Description</label><input class="form-input" id="description" name="description" value="Mobile plan" required maxlength="100"></div>
    <div class="form-group" data-for-types="subscription recurring installments"><label class="form-label" for="amount">Payment amount / usage limit (£)</label><input class="form-input" id="amount" name="amount" type="number" min="0.01" max="10000" step="0.01" value="20.00"></div>
    <div class="form-group" data-for-types="subscription recurring installments hybrid"><label class="form-label" for="frequency">Billing frequency</label><select class="form-input" id="frequency" name="frequency"><option value="monthly">Monthly</option><option value="weekly">Weekly</option><option value="yearly">Yearly</option></select></div>
    <div class="form-group" data-for-types="installments"><label class="form-label" for="installments">Number of installments</label><input class="form-input" id="installments" name="installments" type="number" min="2" max="60" value="12"></div>
    <div class="form-group" data-for-types="hybrid"><label class="form-label" for="setup-fee">One-time setup fee (£)</label><input class="form-input" id="setup-fee" name="oneTimeAmount" type="number" min="0" step="0.01" value="10.00"></div>
    <div class="form-group" data-for-types="hybrid"><label class="form-label" for="recurring-amount">Recurring payment (£)</label><input class="form-input" id="recurring-amount" name="recurringAmount" type="number" min="0.01" step="0.01" value="20.00"></div>
    <div class="form-group" data-for-types="unscheduled"><label class="form-label" for="reload-amount">Top-up amount (£)</label><input class="form-input" id="reload-amount" name="reloadAmount" type="number" min="0.01" step="0.01" value="20.00"></div>
    <div class="form-group" data-for-types="unscheduled"><label class="form-label" for="reload-threshold">Top up when balance falls below (£)</label><input class="form-input" id="reload-threshold" name="reloadThreshold" type="number" min="0.01" step="0.01" value="5.00"></div>
  </form>
  <div class="co-panel">
    <h2 class="co-section-title">Authorize your plan</h2>
    <div class="form-group"><label class="form-label" for="billing-email">Email address (optional)</label><input class="form-input" id="billing-email" type="email" data-billing-email autocomplete="email"></div>
    <p class="billing-consent-copy" data-billing-terms>Preparing the billing terms…</p>
    <label class="billing-consent"><input type="checkbox" data-billing-consent> I authorize saving my payment method and the future charges described above.</label>
    <div data-saved-methods></div><div data-paypal-buttons></div>
    {{> card-payment}}
    <p data-payment-feedback class="payment-feedback" role="status" aria-live="polite">Loading secure payment options…</p>
  </div>
</div></section>
