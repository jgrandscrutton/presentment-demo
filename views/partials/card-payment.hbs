<details class="card-payment-panel">
  <summary>Pay with a card</summary>
  <form data-card-form>
    <div class="form-group"><label class="form-label" for="card-number">Card number</label><div class="hosted-card-field" id="card-number"></div></div>
    <div class="form-row">
      <div class="form-group"><label class="form-label" for="card-expiry">Expiry date</label><div class="hosted-card-field" id="card-expiry"></div></div>
      <div class="form-group"><label class="form-label" for="card-cvv">Security code</label><div class="hosted-card-field" id="card-cvv"></div></div>
    </div>
    <p data-card-feedback class="payment-feedback" role="status" aria-live="polite"></p>
    <button type="submit" class="btn btn-primary" data-card-submit disabled>Continue securely</button>
  </form>
</details>
