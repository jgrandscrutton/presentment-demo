PORT=3000

# Required Braintree sandbox API credentials (loaded from .env)
MERCHANT_ID=your_braintree_merchant_id_here
PUBLIC_KEY=your_braintree_public_key_here
PRIVATE_KEY=your_braintree_private_key_here

# Optional session secret (otherwise generated and persisted with billing records)
# SESSION_SECRET=replace_with_a_random_session_secret

# Optional if your default Braintree merchant account already uses GBP.
# Otherwise set a GBP merchant account for the restored storefront.
# MERCHANT_ACCOUNT_ID=your_merchant_account_id_here

# Optional: a GBP monthly Braintree billing plan. Otherwise a matching plan is
# selected, or created when a buyer approves their first subscription.
# BRAINTREE_BILLING_PLAN_ID=your_monthly_gbp_plan_id

# Apple Pay: enable it in Braintree and register your HTTPS storefront domain.
# Google Pay: enable it in Braintree. Production also needs a Google merchant ID.
# GOOGLE_PAY_MERCHANT_ID=your_google_merchant_id

# Billing records, sessions and vaulted-token references are stored privately here.
# PAYMENTS_DB_PATH=./data/runtime/payments.sqlite

# Signed Braintree webhook endpoint for subscription updates:
# https://your-store-domain/api/webhooks/braintree
